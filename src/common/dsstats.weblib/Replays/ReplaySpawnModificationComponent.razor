@using dsstats.shared

@if (Modifications?.Count > 0)
{
    <div class="mt-1">
        <h4>@ModificationName()</h4>
        @foreach (var modification in Modifications)
        {
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    @modification.TargetUnitName
                </div>
                <div>
                    @modification.Count
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired]
    public Commander Commander { get; set; }
    [Parameter, EditorRequired]
    public List<BuildUnitModificationCountDto>? Modifications { get; set; }

    public string ModificationName()
    {
        return Commander switch
        {
            Commander.Abathur => "Biomass",
            Commander.Alarak => "Power Overwhelming",
            Commander.Artanis => "Guardian Shell",
            Commander.Karax => "Orbital Strike Beacon",
            Commander.Vorazun => "Dark Pylon",
            _ => ""
        };
    }
}
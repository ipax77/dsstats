@using Microsoft.JSInterop
@using dsstats.shared
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div @ref="modal" class="modal ds-detail-view" id="@modalId" aria-hidden="true" aria-labelledby="@titleId" tabindex="-1">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">
            @if (ReplayDetails is not null)
            {
                <ReplayComponent ReplayDetails="ReplayDetails" ModalPresentation="true" TitleId="@titleId"
                                 IsScrollable="IsScrollable" IsCloseable="true" OnScrollRequest="OnScrollRequest" OnPlayerRequest="OnPlayerRequest"
                                 OnPlayerProfileRequest="OnPlayerProfileRequest" OnClose="Close" />
            }
        </div>
    </div>
</div>

@code {
    private readonly string modalId = $"replay-{Guid.NewGuid():N}";
    private string titleId => $"{modalId}-title";
    private ElementReference modal;
    private ReplayDetails? ReplayDetails;
    private IJSObjectReference? module;
    private DotNetObjectReference<ReplayModal>? reference;
    private bool showPending;
    private bool disposed;

    [Parameter] public bool IsScrollable { get; set; }
    [Parameter] public bool IsCloseable { get; set; }
    [Parameter] public EventCallback<PlayerStatsResponse> OnPlayerRequest { get; set; }
    [Parameter] public EventCallback<PlayerProfileRequest> OnPlayerProfileRequest { get; set; }
    [Parameter] public EventCallback<bool> OnScrollRequest { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    public void Show(ReplayDetails replayDetails)
    {
        if (disposed) return;
        ReplayDetails = replayDetails;
        showPending = true;
        _ = InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (disposed) return;
        try
        {
            if (module is null)
            {
                var imported = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./_content/dsstats.weblib/js/replayModal.js");
                if (disposed) { await imported.DisposeAsync(); return; }
                module = imported;
                reference = DotNetObjectReference.Create(this);
                await module.InvokeVoidAsync("initialize", modal, reference);
            }
            if (showPending && !disposed)
            {
                showPending = false;
                await module.InvokeVoidAsync("open", modal);
            }
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
    }

    public async Task Close()
    {
        if (module is not null && !disposed) await module.InvokeVoidAsync("close", modal);
    }

    [JSInvokable]
    public async Task Dismissed()
    {
        if (disposed || ReplayDetails is null) return;
        ReplayDetails = null;
        showPending = false;
        await OnClose.InvokeAsync();
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        try
        {
            if (module is not null)
            {
                await module.InvokeVoidAsync("dispose", modal);
                await module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        finally { reference?.Dispose(); }
    }
}

@using Microsoft.Extensions.Logging
@using dsstats.shared
@using dsstats.shared.Interfaces
@using Microsoft.JSInterop
@using dsstats.weblib.Players.Profile
@using dsstats.weblib.Replays
@inject IPlayerService PlayerService
@inject ILogger<CmdrPlayerMetricsComponent> Logger
@inject IJSRuntime JSRuntime
@implements IDisposable

<div class="container-fluid">
	<div class="d-inline-block bgchart p-2">
		<CascadingValue Value="Request">
			<CmdrPlayerMetricsRequestComponent OnRequestChanged="e => RequestChanged()" />
		</CascadingValue>
	</div>
	<div class="row">
		<div class="col-auto">
			<div style="height: 30px;">
				@if (isLoading)
				{
					<div class="spinner-border spinner-border-sm text-danger" role="status">
						<span class="visually-hidden">Loading...</span>
					</div>
				}
			</div>
			<div class="d-flex bgchart p-1 rounded">
				<div>
					<h4>
						Players who played
						<span class="text-warning">@Request.Interest </span>
						and their success
						<span class="text-light" style="font-size: 1rem;"> (&sum; > @(Request.RatingType == RatingType.CommandersTE ? "1" : "9"))</span>
					</h4>
				</div>
				<div class="ms-auto">
					&Oslash;
					<span class="@(avgGain < 0 ? "text-danger" : "text-success")">
						@avgGain.ToString("N2")
					</span>
				</div>
			</div>
			@if (loadError is not null)
			{
				<div class="alert alert-danger" role="alert">@loadError</div>
			}
			<CmdrPlayerMetricsInfoComponent Response="response" SelectedPlayerId="selectedPlayerId"
				OnPlayerDetailsRequest="ShowPlayerDetails" OnPlayerReplaysRequest="ShowPlayerReplays" />
		</div>
		<div class="col-auto" style="min-width: 700px;">
			<div class="ms-2 mb-2">
				<button class="btn btn-sm btn-outline-light bgchart"
						type="button"
						id="buildreplaystoggle"
						aria-expanded="@(showReplays ? "true" : "false")"
						aria-controls="buildreplays"
						@onclick="e => showReplays = !showReplays">
					<span class="bi @(showReplays ? "bi bi-chevron-double-down" : "bi-chevron-double-up")"></span>
					Replays
				</button>
				@if (selectedPlayerId is not null)
				{
					<div class="ms-2 p-2 d-inline rounded bgchart">
						<span class="ms-2">@selectedPlayerName</span>
						<button class="btn btn-sm btn-outline-light ms-2" type="button" @onclick="ClearPlayerSelection">All players</button>
					</div>
				}
			</div>
			<div id="buildreplays">
				@if (showReplays)
				{
					<div class="bgchart p-1 rounded">
						<ReplaysComponent @key="replaysRequest" ReplaysRequest="replaysRequest" />
					</div>
				}
			</div>
		</div>
		<div class="col-auto">
			<div class="ms-2 mt-2 p-2 bgchart text-warning" style="max-width: 1000px;">
				<p>
					This table, referred to as 'Player Metrics by Commander', offers valuable insights into the success and impact of players who choose a specific commander.
				</p>
				<p>
					<strong>Strength</strong> is a combined rating from <strong>0 to 100</strong> that reflects a player’s overall
					performance with this commander. It is based on four factors:
					winrate, average rating, rating gain, and number of matchups. These values are normalized using a fixed
					global scale, allowing strength scores to be compared fairly across different commanders.
				</p>
			</div>
		</div>
	</div>
</div>
<PlayerProfileModal @ref="playerProfileModal" />

@code {
	[Parameter, EditorRequired]
	public CmdrStrenghtRequest Request { get; set; } = default!;
	[Parameter]
	public EventCallback<CmdrStrenghtRequest> OnRequestChanged { get; set; }

	bool isLoading = false;

	CmdrStrenghtResponse response = new();
	double avgGain => response.Items.Count == 0 ? 0 : Math.Round(response.Items.Average(a => a.AvgGain), 2);

	private bool showReplays;
	PlayerProfileModal? playerProfileModal;
	ReplaysRequest replaysRequest = new();
	ToonIdDto? selectedPlayerId;
	string? selectedPlayerName;
	string? loadError;
	int requestVersion;
	bool disposed;
	bool refreshTooltips;

	protected override Task OnInitializedAsync() => RequestChanged(true);

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender || refreshTooltips)
		{
			refreshTooltips = false;
			await JSRuntime.InvokeVoidAsync("enableTooltips");
		}
	}

	private Task ShowPlayerDetails(ToonIdDto toonId) => playerProfileModal!.Show(new()
	{
		ToonId = toonId,
		RatingType = Request.RatingType
	});

	private void ShowPlayerReplays(ToonIdDto toonId)
	{
		selectedPlayerId = toonId;
		selectedPlayerName = response.Items.FirstOrDefault(x => x.ToonId == toonId)?.Name;
		RebuildReplayRequest();
		showReplays = true;
	}

	private void ClearPlayerSelection()
	{
		selectedPlayerId = null;
		selectedPlayerName = null;
		RebuildReplayRequest();
	}

	private void RebuildReplayRequest()
	{
		replaysRequest = new()
		{
			RatingType = Request.RatingType,
			Commander = selectedPlayerId is null && Request.Interest != Commander.None ? Request.Interest.ToString() : null,
			Filter = new()
			{
				TimePeriod = Request.TimePeriod,
				TournamentEdition = Request.RatingType is RatingType.StandardTE or RatingType.CommandersTE,
				GameModes = Request.RatingType switch
				{
					RatingType.Standard or RatingType.StandardTE => [GameMode.Standard],
					RatingType.Commanders or RatingType.CommandersTE => [GameMode.Commanders],
					_ => []
				},
				PosFilters = selectedPlayerId is null ? [] : [new()
				{
					Commander = Request.Interest,
					PlayerNameOrId = Data.GetToonIdString(selectedPlayerId)
				}]
			}
		};
	}

	public async Task RequestChanged(bool init = false)
	{
		var version = ++requestVersion;
		ClearPlayerSelection();
		response = new();
		loadError = null;
		isLoading = true;
		// The form mutates Request in place, so each load needs its own snapshot.
		var request = new CmdrStrenghtRequest
		{
			Interest = Request.Interest,
			RatingType = Request.RatingType,
			TimePeriod = Request.TimePeriod,
			MaxRating = Request.MaxRating,
			MinRating = Request.MinRating,
			MaxGap = Request.MaxGap,
			WithoutLeavers = Request.WithoutLeavers,
			Uploaders = Request.Uploaders
		};
		try
		{
			var result = await PlayerService.GetCmdrPlayerInfos(request);
			if (disposed || version != requestVersion) return;
			response = result;
			refreshTooltips = true;
			if (!init)
			{
				await OnRequestChanged.InvokeAsync(Request);
			}
		}
		catch (Exception ex)
		{
			Logger.LogError(ex, "Error loading commander player metrics");
			if (!disposed && version == requestVersion)
				loadError = "Unable to load player metrics. Please try changing the filters again.";
		}
		finally
		{
			if (!disposed && version == requestVersion)
				isLoading = false;
		}
	}

	public void Dispose()
	{
		disposed = true;
	}
}

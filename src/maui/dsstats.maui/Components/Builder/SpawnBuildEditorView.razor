@using dsstats.shared
@using dsstats.shared.Builder

<div class="spawn-editor card bg-dark text-light mt-3">
    <div class="card-header d-flex flex-wrap gap-2 align-items-center justify-content-between">
        <strong>Spawn editor</strong>
        <div class="btn-group btn-group-sm" role="group" aria-label="Visible unit layer">
            <button class="btn @(layer == BuildLayer.Ground ? "btn-info" : "btn-outline-info")" @onclick="() => SetLayer(BuildLayer.Ground)">Ground</button>
            <button class="btn @(layer == BuildLayer.Air ? "btn-info" : "btn-outline-info")" @onclick="() => SetLayer(BuildLayer.Air)">Air</button>
        </div>
    </div>
    <div class="card-body">
        @if (editor is null)
        {
            <div class="row g-2 align-items-end">
                <div class="col-sm-5"><label class="form-label">Commander</label><select class="form-select bg-dark text-light" @bind="newCommander">@foreach (var item in SupportedCommanders) { <option value="@item">@item</option> }</select></div>
                <div class="col-sm-4"><label class="form-label">Encoded side</label><select class="form-select bg-dark text-light" @bind="newTeam"><option value="1">Position 1</option><option value="2">Position 4</option></select></div>
                <div class="col-sm-3 d-flex gap-2"><button class="btn btn-info" @onclick="Create">Create</button><button class="btn btn-outline-info" disabled="@string.IsNullOrWhiteSpace(Fen)" @onclick="Import">Edit FEN</button></div>
            </div>
        }
        else
        {
            <div class="row g-3">
                <div class="col-lg-4">
                    <label class="form-label">@layer units</label>
                    <select class="form-select form-select-sm bg-dark text-light mb-2" @bind="selectedSymbol">
                        @foreach (var unit in VisibleDefinitions) { <option value="@unit.Symbol">@unit.Name (@unit.Footprint×@unit.Footprint)</option> }
                    </select>
                    <div class="small text-light-emphasis mb-3">Click an empty cell to add. Click a unit to select it, then click an empty cell to move it.</div>
                    <div class="d-flex flex-wrap gap-2">
                        <button class="btn btn-sm btn-outline-danger" disabled="@(selectedId is null)" @onclick="RemoveSelected">Remove</button>
                        <button class="btn btn-sm btn-outline-warning" disabled="@(selectedId is null)" @onclick="ReplaceSelected">Replace type</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="ClearLayer">Clear @layer</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="Close">Close</button>
                    </div>
                    @if (!string.IsNullOrEmpty(message)) { <div class="small mt-2 @(failed ? "text-danger" : "text-success")">@message</div> }
                </div>
                <div class="col-lg-8">
                    <svg class="spawn-editor-board" viewBox="0 0 @(SpawnBuilderFen.Width * 20) @(SpawnBuilderFen.Height * 20)" role="application" aria-label="Direct Strike build placement grid">
                        @for (var y = 0; y < SpawnBuilderFen.Height; y++)
                        {
                            @for (var x = 0; x < SpawnBuilderFen.Width; x++)
                            {
                                var cell = new BuildCell(x, y);
                                if (SpawnBuilderFen.IsValidCell(editor.Team, new(x, y)))
                                {
                                    <rect class="grid-cell" x="@(x * 20)" y="@((SpawnBuilderFen.Height - 1 - y) * 20)" width="20" height="20" @onclick="() => BoardClick(cell)" />
                                }
                            }
                        }
                        @foreach (var unit in VisibleUnits)
                        {
                            var size = unit.Definition.Footprint * 20;
                            <g class="placed-unit @(selectedId == unit.Id ? "selected" : null)" @onclick:stopPropagation @onclick="() => Select(unit.Id)">
                                <rect x="@(unit.Cell.X * 20 + 1)" y="@((SpawnBuilderFen.Height - unit.Cell.Y - unit.Definition.Footprint) * 20 + 1)" width="@(size - 2)" height="@(size - 2)" rx="3" />
                                <text x="@(unit.Cell.X * 20 + size / 2)" y="@((SpawnBuilderFen.Height - unit.Cell.Y) * 20 - size / 2 + 4)" text-anchor="middle">@unit.Definition.Symbol</text>
                                <title>@unit.Definition.Name</title>
                            </g>
                        }
                    </svg>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string Fen { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> FenChanged { get; set; }
    private static readonly Commander[] SupportedCommanders = [Commander.Protoss, Commander.Terran, Commander.Zerg];
    private SpawnBuildEditor? editor;
    private Commander newCommander = Commander.Protoss;
    private int newTeam = 1;
    private BuildLayer layer;
    private char selectedSymbol = 'a';
    private int? selectedId;
    private string message = string.Empty;
    private bool failed;
    private IEnumerable<BuilderUnitDefinition> VisibleDefinitions => BuilderUnitCatalog.GetUnits(editor!.Commander).Where(u => u.IsAir == (layer == BuildLayer.Air));
    private IEnumerable<PlacedBuildUnit> VisibleUnits => editor!.Units.Where(u => u.Layer == layer);

    private void Create() { editor = new(newCommander, newTeam); LayerChanged(); message = "New empty build created."; }
    private void Import()
    {
        if (!SpawnBuilderFen.TryDecode(Fen, out var decoded)) { failed = true; message = "The FEN cannot be edited because it is invalid."; return; }
        editor = SpawnBuildEditor.From(decoded); newCommander = decoded.Commander; newTeam = decoded.Team; LayerChanged(); message = "FEN loaded.";
    }
    private void LayerChanged() { selectedId = null; selectedSymbol = VisibleDefinitions.FirstOrDefault()?.Symbol ?? '\0'; }
    private void SetLayer(BuildLayer value) { layer = value; if (editor is not null) LayerChanged(); }
    private void Select(int id) => selectedId = id;
    private async Task BoardClick(BuildCell cell)
    {
        if (selectedId is int id && editor!.Units.FirstOrDefault(u => u.Id == id) is { } selected)
        { await Run(new MoveUnits([id], cell.X - selected.Cell.X, cell.Y - selected.Cell.Y)); selectedId = null; return; }
        var definition = VisibleDefinitions.FirstOrDefault(u => u.Symbol == selectedSymbol);
        if (definition is not null) await Run(new AddUnit(definition, cell));
    }
    private Task RemoveSelected() => Run(new RemoveUnits(selectedId is int id ? [id] : []));
    private Task ReplaceSelected() { var definition = VisibleDefinitions.First(u => u.Symbol == selectedSymbol); return Run(new ReplaceUnitType(selectedId is int id ? [id] : [], definition)); }
    private Task ClearLayer() => Run(new ClearBuild(layer));
    private void Close() { editor = null; selectedId = null; }
    private async Task Run(IBuildEditCommand command)
    {
        failed = !editor!.Execute(command, out var error); message = error ?? "FEN updated.";
        if (!failed)
        {
            var existingUpgrades = SpawnBuilderFen.TryDecode(Fen, out var old) && old.Commander == editor.Commander ? old.Upgrades : [];
            var updated = SpawnBuilderFen.Encode(editor.Commander, editor.Team, editor.ToSpawn(), existingUpgrades);
            await FenChanged.InvokeAsync(updated);
        }
    }
}

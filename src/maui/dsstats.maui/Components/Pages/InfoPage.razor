@page "/info"

<PageTitle>dsstats - info</PageTitle>

<div class="container-fluid">
	<div class="bgchart border rounded p-4">
		<h1 class="h3 text-warning mb-3">About dsstats</h1>
		<p class="text-muted mb-4">
			dsstats is a fan project for analyzing StarCraft II Direct Strike replays.
		</p>

		<div class="list-group">
			<a class="list-group-item list-group-item-action bgchart text-light"
			   href="https://github.com/ipax77/dsstats/wiki"
			   target="_blank"
			   rel="noopener noreferrer">
				<i class="bi bi-book me-2" aria-hidden="true"></i>
				<span class="fw-semibold">Wiki</span>
				<span class="d-block small text-muted ms-4">Documentation and guides</span>
			</a>

			<a class="list-group-item list-group-item-action bgchart text-light"
			   href="https://github.com/ipax77/dsstats/issues"
			   target="_blank"
			   rel="noopener noreferrer">
				<i class="bi bi-bug me-2" aria-hidden="true"></i>
				<span class="fw-semibold">Report an issue</span>
				<span class="d-block small text-muted ms-4">Report bugs or suggest improvements</span>
			</a>

			<a class="list-group-item list-group-item-action bgchart text-light"
			   href="https://github.com/ipax77/dsstats"
			   target="_blank"
			   rel="noopener noreferrer">
				<i class="bi bi-github me-2" aria-hidden="true"></i>
				<span class="fw-semibold">GitHub repository</span>
				<span class="d-block small text-muted ms-4">Browse the source code and project history</span>
			</a>
		</div>
	</div>
</div>
